{
  "swagger": "2.0",
  "info": {
    "title": "ECL Graph Transcript Gateway",
    "description": "Power Automate connector for the ECL certificate-authenticated Microsoft Graph transcript gateway.",
    "version": "1.1.0"
  },
  "host": "ecl-graph-gateway.azurewebsites.net",
  "basePath": "/api",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json", "text/vtt"],
  "paths": {
    "/meetings/resolve": {
      "get": {
        "operationId": "ResolveMeeting",
        "summary": "Resolve a meeting",
        "parameters": [
          { "name": "organizerUserId", "in": "query", "required": true, "type": "string", "description": "Microsoft Entra object ID of the meeting organizer." },
          { "name": "joinUrl", "in": "query", "required": true, "type": "string", "description": "Full Microsoft Teams join URL." }
        ],
        "responses": {
          "200": {
            "description": "Resolved online meeting",
            "schema": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "subject": { "type": "string", "x-nullable": true },
                "joinWebUrl": { "type": "string", "x-nullable": true },
                "startDateTime": { "type": "string", "format": "date-time", "x-nullable": true },
                "endDateTime": { "type": "string", "format": "date-time", "x-nullable": true }
              }
            }
          },
          "404": { "description": "No matching active meeting" },
          "409": { "description": "Meeting lookup was not unique" }
        }
      }
    },
    "/users/{organizerUserId}/transcripts/discover": {
      "get": {
        "operationId": "DiscoverTranscripts",
        "summary": "Discover scheduled Teams meeting transcripts",
        "description": "Returns transcript artifacts created for scheduled Teams meetings organized by the specified approved user within a bounded UTC window.",
        "parameters": [
          { "name": "organizerUserId", "in": "path", "required": true, "type": "string", "description": "Microsoft Entra object ID of the approved meeting organizer." },
          { "name": "startDateTime", "in": "query", "required": true, "type": "string", "format": "date-time", "description": "Inclusive UTC discovery-window start." },
          { "name": "endDateTime", "in": "query", "required": true, "type": "string", "format": "date-time", "description": "Exclusive UTC discovery-window end. The window may not exceed 24 hours." },
          { "name": "checkpoint", "in": "query", "required": false, "type": "string", "description": "Opaque Microsoft Graph delta URL from the preceding successful discovery. When present, the gateway validates and follows it instead of starting a new window." }
        ],
        "responses": {
          "200": {
            "description": "Transcript artifacts grouped by the caller after retrieval",
            "schema": {
              "type": "object",
              "required": ["value"],
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "meetingId"],
                    "properties": {
                      "id": { "type": "string" },
                      "meetingId": { "type": "string" },
                      "createdDateTime": { "type": "string", "format": "date-time", "x-nullable": true },
                      "endDateTime": { "type": "string", "format": "date-time", "x-nullable": true },
                      "meetingOrganizer": {
                        "type": "object",
                        "x-nullable": true,
                        "properties": {
                          "id": { "type": "string", "x-nullable": true },
                          "displayName": { "type": "string", "x-nullable": true }
                        }
                      }
                    }
                  }
                },
                "deltaLink": { "type": "string", "x-nullable": true, "description": "Opaque Graph synchronization checkpoint when supplied." }
              }
            }
          },
          "400": { "description": "Invalid organizer or discovery window" },
          "403": { "description": "Transcript API access is disabled or the organizer is not approved" }
        }
      }
    },
    "/users/{organizerUserId}/onlineMeetings/{meetingId}": {
      "get": {
        "operationId": "GetMeeting",
        "summary": "Get Teams meeting metadata",
        "parameters": [
          { "name": "organizerUserId", "in": "path", "required": true, "type": "string" },
          { "name": "meetingId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Online meeting metadata",
            "schema": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "subject": { "type": "string", "x-nullable": true },
                "joinWebUrl": { "type": "string", "x-nullable": true },
                "startDateTime": { "type": "string", "format": "date-time", "x-nullable": true },
                "endDateTime": { "type": "string", "format": "date-time", "x-nullable": true },
                "meetingType": { "type": "string", "x-nullable": true },
                "organizer": {
                  "type": "object",
                  "x-nullable": true,
                  "properties": {
                    "id": { "type": "string", "x-nullable": true },
                    "displayName": { "type": "string", "x-nullable": true }
                  }
                }
              }
            }
          },
          "404": { "description": "Online meeting not found" }
        }
      }
    },
    "/users/{organizerUserId}/onlineMeetings/{meetingId}/transcripts": {
      "get": {
        "operationId": "ListTranscripts",
        "summary": "List meeting transcripts",
        "parameters": [
          { "name": "organizerUserId", "in": "path", "required": true, "type": "string" },
          { "name": "meetingId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": {
            "description": "Transcript collection",
            "schema": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                      "id": { "type": "string" },
                      "createdDateTime": { "type": "string", "format": "date-time", "x-nullable": true },
                      "endDateTime": { "type": "string", "format": "date-time", "x-nullable": true }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/{organizerUserId}/onlineMeetings/{meetingId}/transcripts/{transcriptId}/content": {
      "get": {
        "operationId": "GetTranscriptContent",
        "summary": "Download transcript content",
        "produces": ["text/vtt"],
        "parameters": [
          { "name": "organizerUserId", "in": "path", "required": true, "type": "string" },
          { "name": "meetingId", "in": "path", "required": true, "type": "string" },
          { "name": "transcriptId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "WebVTT transcript", "schema": { "type": "string" } }
        }
      }
    }
  },
  "securityDefinitions": {
    "function_key": {
      "type": "apiKey",
      "name": "x-functions-key",
      "in": "header"
    }
  },
  "security": [{ "function_key": [] }]
}
