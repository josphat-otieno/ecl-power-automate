{
  "mcpServers": {
    "powerautomate-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "powerautomate-mcp@latest"
      ],
      "env": {
        "PA_MCP_CLIENT_ID": "${PA_MCP_CLIENT_ID}",
        "PA_MCP_TENANT_ID": "${PA_MCP_TENANT_ID}",
        "PA_MCP_ENVIRONMENT_ID": "${PA_MCP_ENVIRONMENT_ID}",
        "PA_MCP_ENVIRONMENT_REGION": "${PA_MCP_ENVIRONMENT_REGION}"
      }
    }
  }
}
